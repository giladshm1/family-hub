rules_version = '2';

// Family Hub — server-side permissions. Source: firestore.rules in the GitHub repo.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function ownerPath() { return /databases/$(database)/documents/meta/owner; }
    function linkPath() { return /databases/$(database)/documents/links/$(request.auth.uid); }
    function isOwner() { return signedIn() && exists(ownerPath()) && get(ownerPath()).data.uid == request.auth.uid; }
    function isLinked() { return signedIn() && exists(linkPath()); }
    function myMemberId() { return get(linkPath()).data.memberId; }
    function myMember() { return get(/databases/$(database)/documents/members/$(myMemberId())).data; }
    function isAdmin() { return isOwner() || (isLinked() && myMember().isAdmin == true); }
    function canScore() { return isLinked() && myMember().get('canScore', false) == true; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // First person to set up the app becomes the owner (always an admin).
    match /meta/owner {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Family members + dishwashing scores: everyone in the family reads.
    // Only members with canScore (dad) may change scores; admins edit everything else.
    // Nobody can grant canScore from the app — only from the Firebase console.
    match /members/{memberId} {
      allow read: if isLinked() || isOwner();
      allow create: if isAdmin() && request.resource.data.get('score', 0) == 0;
      allow update: if (canScore() && changed().hasOnly(['score']) && request.resource.data.score >= 0)
                    || (isAdmin() && !changed().hasAny(['score', 'canScore']));
      allow delete: if isAdmin();
    }

    // Google account -> family member. Admins manage; you can read your own.
    match /links/{uid} {
      allow read: if signedIn() && (uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // New sign-ins waiting for an admin.
    match /pending/{uid} {
      allow read: if isAdmin() || (signedIn() && uid == request.auth.uid);
      allow create, update: if signedIn() && uid == request.auth.uid;
      allow delete: if isAdmin() || (signedIn() && uid == request.auth.uid);
    }

    // Car bookings: family reads; you book as yourself; owner of the booking or an admin cancels.
    match /reservations/{id} {
      allow read: if isLinked();
      allow create: if isLinked()
        && request.resource.data.memberId == myMemberId()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.carId in ['car1', 'car2']
        && request.resource.data.start is int
        && request.resource.data.end is int
        && request.resource.data.end > request.resource.data.start
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 40;
      allow update: if false;
      allow delete: if isAdmin() || (isLinked() && resource.data.memberId == myMemberId());
    }

    // Where each car is parked: any family member updates it (as themselves).
    match /parking/{carId} {
      allow read: if isLinked();
      allow create, update: if isLinked()
        && carId in ['car1', 'car2']
        && request.resource.data.keys().hasOnly(['text', 'lat', 'lng', 'by', 'uid', 'at'])
        && request.resource.data.by == myMemberId()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 80;
    }

    // Shared shopping list: anyone in the family adds (as themselves), checks off, and removes.
    match /shopping/{id} {
      allow read: if isLinked();
      allow create: if isLinked()
        && request.resource.data.keys().hasOnly(['text', 'qty', 'addedBy', 'uid', 'done', 'createdAt'])
        && request.resource.data.addedBy == myMemberId()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 60
        && request.resource.data.qty is string && request.resource.data.qty.size() <= 20
        && request.resource.data.done == false;
      allow update: if isLinked()
        && changed().hasOnly(['done', 'doneBy', 'doneAt'])
        && request.resource.data.done is bool;
      allow delete: if isLinked();
    }
  }
}
